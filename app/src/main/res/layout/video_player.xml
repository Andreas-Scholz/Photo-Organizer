<?xml version="1.0" encoding="utf-8"?>
<!--
    A TextureView is drawn as part of the view hierarchy. The default SurfaceView lives in
    its own window layer and stays black inside the clipped, transformed review card.
    The surface type can only be chosen through this attribute, hence the layout file.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
